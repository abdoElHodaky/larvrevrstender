# Laravel Vapor Environment Configuration - DigitalOcean Serverless
# Hybrid deployment: Traditional services + Serverless functions

# Application
APP_NAME="Notification System"
APP_ENV=production
APP_KEY=${VAPOR_APP_KEY}
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

# Database (DigitalOcean Managed MySQL)
DB_CONNECTION=mysql
DB_HOST=${DO_DB_HOST}
DB_PORT=${DO_DB_PORT}
DB_DATABASE=${DO_DB_DATABASE}
DB_USERNAME=${DO_DB_USERNAME}
DB_PASSWORD=${DO_DB_PASSWORD}

# SSL Configuration for DigitalOcean Database
MYSQL_ATTR_SSL_CA=${DO_DB_SSL_CA}
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# Cache (DigitalOcean Managed Redis)
CACHE_DRIVER=redis
REDIS_HOST=${DO_REDIS_HOST}
REDIS_PASSWORD=${DO_REDIS_PASSWORD}
REDIS_PORT=${DO_REDIS_PORT}
REDIS_DB=0

# Queue
QUEUE_CONNECTION=redis
REDIS_QUEUE=notifications

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com

# Serverless Configuration
SERVERLESS_PROVIDER=digitalocean
SERVERLESS_ENABLED=true
SERVERLESS_API_KEY=${DO_FUNCTIONS_API_KEY}

# DigitalOcean Functions Endpoints
SERVERLESS_EMAIL_ENDPOINT=https://faas-nyc1-2ef2e6cc.doserverless.co/api/v1/web/fn-email-processor/email/send
SERVERLESS_SMS_ENDPOINT=https://faas-nyc1-2ef2e6cc.doserverless.co/api/v1/web/fn-sms-processor/sms/send
SERVERLESS_PUSH_ENDPOINT=https://faas-nyc1-2ef2e6cc.doserverless.co/api/v1/web/fn-push-processor/push/send
SERVERLESS_WHATSAPP_ENDPOINT=https://faas-nyc1-2ef2e6cc.doserverless.co/api/v1/web/fn-whatsapp-processor/whatsapp/send

# Service Communication
SERVICE_COMMUNICATION_METHOD=hybrid
CIRCUIT_BREAKER_THRESHOLD=10
CIRCUIT_BREAKER_TIMEOUT=60

# Monitoring
TRACE_SERVICE_REQUESTS=true
SERVICE_LOG_LEVEL=info
SERVICE_METRICS_ENABLED=true

# Security
API_KEYS_SERVERLESS_FUNCTIONS=${DO_FUNCTIONS_API_KEY}

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Broadcasting
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Mail (for system notifications)
MAIL_MAILER=smtp
MAIL_HOST=${DO_MAIL_HOST}
MAIL_PORT=${DO_MAIL_PORT}
MAIL_USERNAME=${DO_MAIL_USERNAME}
MAIL_PASSWORD=${DO_MAIL_PASSWORD}
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Your App"

# File Storage (DigitalOcean Spaces)
FILESYSTEM_DISK=spaces
DO_SPACES_KEY=${DO_SPACES_KEY}
DO_SPACES_SECRET=${DO_SPACES_SECRET}
DO_SPACES_ENDPOINT=${DO_SPACES_ENDPOINT}
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=notification-assets
DO_SPACES_URL=https://notification-assets.nyc3.digitaloceanspaces.com
DO_SPACES_USE_PATH_STYLE_ENDPOINT=false

# SMS Configuration (MENA Providers)
SMS_PROVIDER=unifonic
UNIFONIC_API_KEY=${UNIFONIC_API_KEY}
UNIFONIC_SENDER_ID=${UNIFONIC_SENDER_ID}
MSEGAT_API_KEY=${MSEGAT_API_KEY}
MSEGAT_USERNAME=${MSEGAT_USERNAME}
OURSMS_API_KEY=${OURSMS_API_KEY}
OURSMS_SENDER_ID=${OURSMS_SENDER_ID}
INFOBIP_API_KEY=${INFOBIP_API_KEY}
INFOBIP_BASE_URL=${INFOBIP_BASE_URL}

# Push Notifications (FCM)
FCM_SERVER_KEY=${FCM_SERVER_KEY}
FCM_PROJECT_ID=${FCM_PROJECT_ID}

# WhatsApp Configuration (MENA Providers)
WHATSAPP_SID=${WHATSAPP_SID}
WHATSAPP_TOKEN=${WHATSAPP_TOKEN}
WHATSAPP_FROM=${WHATSAPP_FROM}

# Telegram Configuration
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}

# Rate Limiting
RATE_LIMIT_EMAIL_PER_MINUTE=60
RATE_LIMIT_SMS_PER_MINUTE=30
RATE_LIMIT_PUSH_PER_MINUTE=100
RATE_LIMIT_WHATSAPP_PER_MINUTE=20

# Template Configuration
TEMPLATE_CACHE_TTL=3600
TEMPLATE_DEFAULT_LANGUAGE=en

# Notification Configuration
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY=300
NOTIFICATION_BATCH_SIZE=100

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_CACHE_TTL=30

# Vapor-specific Configuration
VAPOR_ENVIRONMENT=production
VAPOR_REGION=nyc1
VAPOR_PROVIDER=digitalocean

# Performance Configuration
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000
OCTANE_WORKERS=auto
OCTANE_TASK_WORKERS=auto
OCTANE_MAX_REQUESTS=500

# Queue Worker Configuration
QUEUE_WORKER_TIMEOUT=60
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_BACKOFF=10

# Serverless Function Configuration
FUNCTION_TIMEOUT=300
FUNCTION_MEMORY=512
FUNCTION_RUNTIME=php81

# DigitalOcean Specific Configuration
DO_REGION=nyc1
DO_SIZE=s-2vcpu-4gb
DO_IMAGE=ubuntu-22-04-x64

# Load Balancer Configuration
LOAD_BALANCER_ENABLED=true
LOAD_BALANCER_ALGORITHM=round_robin
LOAD_BALANCER_SIZE=lb-small

# Monitoring and Metrics
METRICS_ENABLED=true
METRICS_DRIVER=digitalocean
METRICS_NAMESPACE=notification-system

# DigitalOcean Monitoring
DO_MONITORING_ENABLED=true
DO_UPTIME_CHECKS_ENABLED=true
DO_ALERTS_ENABLED=true
DO_ALERT_EMAIL=admin@yourdomain.com

# Error Tracking (Sentry)
SENTRY_LARAVEL_DSN=${SENTRY_DSN}
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_DISK=spaces
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Auto-scaling Configuration
AUTO_SCALING_ENABLED=true
AUTO_SCALING_MIN_INSTANCES=1
AUTO_SCALING_MAX_INSTANCES=5
AUTO_SCALING_TARGET_CPU=70
AUTO_SCALING_TARGET_MEMORY=80

# Firewall Configuration
FIREWALL_ENABLED=true
FIREWALL_INBOUND_RULES=http,https,ssh
FIREWALL_OUTBOUND_RULES=all

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_CERTIFICATE_TYPE=lets_encrypt
SSL_DOMAINS=api.yourdomain.com,notification-core.yourdomain.com

# CDN Configuration
CDN_ENABLED=true
CDN_ENDPOINT=${DO_SPACES_URL}

# Alternative Email Providers
MAILGUN_DOMAIN=${MAILGUN_DOMAIN}
MAILGUN_SECRET=${MAILGUN_SECRET}
MAILGUN_ENDPOINT=api.mailgun.net

SENDGRID_API_KEY=${SENDGRID_API_KEY}

# Alternative SMS Providers
NEXMO_KEY=${NEXMO_KEY}
NEXMO_SECRET=${NEXMO_SECRET}

# Webhook Configuration
WEBHOOK_ENABLED=true
WEBHOOK_SECRET=${WEBHOOK_SECRET}
WEBHOOK_TIMEOUT=30

# Cache Tags (for advanced caching)
CACHE_TAGS_ENABLED=true

# Notification Channels Configuration
NOTIFICATION_CHANNELS_EMAIL=true
NOTIFICATION_CHANNELS_SMS=true
NOTIFICATION_CHANNELS_PUSH=true
NOTIFICATION_CHANNELS_WHATSAPP=true
NOTIFICATION_CHANNELS_TELEGRAM=true

# Horizon (for queue management)
HORIZON_ENABLED=true
HORIZON_PREFIX=notification-system
HORIZON_BALANCE=auto
HORIZON_MAX_PROCESSES=10

# Telescope (if enabled for debugging)
TELESCOPE_ENABLED=false
TELESCOPE_DRIVER=database

# Vite (for asset compilation)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
