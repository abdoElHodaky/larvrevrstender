# Laravel Vapor Environment Configuration - Linode Serverless
# Hybrid deployment: Traditional services + Serverless functions

# Application
APP_NAME="Notification System"
APP_ENV=production
APP_KEY=${VAPOR_APP_KEY}
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

# Database (Linode Managed MySQL)
DB_CONNECTION=mysql
DB_HOST=${LINODE_DB_HOST}
DB_PORT=${LINODE_DB_PORT}
DB_DATABASE=${LINODE_DB_DATABASE}
DB_USERNAME=${LINODE_DB_USERNAME}
DB_PASSWORD=${LINODE_DB_PASSWORD}

# SSL Configuration for Linode Database
MYSQL_ATTR_SSL_CA=${LINODE_DB_SSL_CA}
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# Cache (Linode Managed Redis)
CACHE_DRIVER=redis
REDIS_HOST=${LINODE_REDIS_HOST}
REDIS_PASSWORD=${LINODE_REDIS_PASSWORD}
REDIS_PORT=${LINODE_REDIS_PORT}
REDIS_DB=0

# Queue
QUEUE_CONNECTION=redis
REDIS_QUEUE=notifications

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com

# Serverless Configuration
SERVERLESS_PROVIDER=linode
SERVERLESS_ENABLED=true
SERVERLESS_API_KEY=${LINODE_FUNCTIONS_API_KEY}

# Serverless Function Endpoints
SERVERLESS_EMAIL_ENDPOINT=https://email-processor.linode-functions.net/email/send
SERVERLESS_SMS_ENDPOINT=https://sms-processor.linode-functions.net/sms/send
SERVERLESS_PUSH_ENDPOINT=https://push-processor.linode-functions.net/push/send

# Service Communication
SERVICE_COMMUNICATION_METHOD=hybrid
CIRCUIT_BREAKER_THRESHOLD=10
CIRCUIT_BREAKER_TIMEOUT=60

# Monitoring
TRACE_SERVICE_REQUESTS=true
SERVICE_LOG_LEVEL=info
SERVICE_METRICS_ENABLED=true

# Security
API_KEYS_SERVERLESS_FUNCTIONS=${LINODE_FUNCTIONS_API_KEY}

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Broadcasting
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Mail (for system notifications)
MAIL_MAILER=smtp
MAIL_HOST=${LINODE_MAIL_HOST}
MAIL_PORT=${LINODE_MAIL_PORT}
MAIL_USERNAME=${LINODE_MAIL_USERNAME}
MAIL_PASSWORD=${LINODE_MAIL_PASSWORD}
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Your App"

# File Storage (Linode Object Storage)
FILESYSTEM_DISK=linode
LINODE_ACCESS_KEY=${LINODE_ACCESS_KEY}
LINODE_SECRET_KEY=${LINODE_SECRET_KEY}
LINODE_REGION=us-east-1
LINODE_BUCKET=notification-assets
LINODE_ENDPOINT=https://us-east-1.linodeobjects.com
LINODE_USE_PATH_STYLE_ENDPOINT=false

# SMS Configuration (Twilio)
TWILIO_SID=${TWILIO_SID}
TWILIO_TOKEN=${TWILIO_TOKEN}
TWILIO_FROM=${TWILIO_FROM}

# Push Notifications (FCM)
FCM_SERVER_KEY=${FCM_SERVER_KEY}
FCM_PROJECT_ID=${FCM_PROJECT_ID}

# WhatsApp Configuration (Twilio)
WHATSAPP_SID=${WHATSAPP_SID}
WHATSAPP_TOKEN=${WHATSAPP_TOKEN}
WHATSAPP_FROM=${WHATSAPP_FROM}

# Telegram Configuration
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}

# Rate Limiting
RATE_LIMIT_EMAIL_PER_MINUTE=60
RATE_LIMIT_SMS_PER_MINUTE=30
RATE_LIMIT_PUSH_PER_MINUTE=100

# Template Configuration
TEMPLATE_CACHE_TTL=3600
TEMPLATE_DEFAULT_LANGUAGE=en

# Notification Configuration
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY=300
NOTIFICATION_BATCH_SIZE=100

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_CACHE_TTL=30

# Vapor-specific Configuration
VAPOR_ENVIRONMENT=production
VAPOR_REGION=us-east
VAPOR_PROVIDER=linode

# Performance Configuration
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000
OCTANE_WORKERS=auto
OCTANE_TASK_WORKERS=auto
OCTANE_MAX_REQUESTS=500

# Queue Worker Configuration
QUEUE_WORKER_TIMEOUT=60
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_BACKOFF=10

# Serverless Function Configuration
FUNCTION_TIMEOUT=300
FUNCTION_MEMORY=512
FUNCTION_RUNTIME=nodejs18

# Monitoring and Metrics
METRICS_ENABLED=true
METRICS_DRIVER=linode
METRICS_NAMESPACE=notification-system

# Error Tracking (Sentry)
SENTRY_LARAVEL_DSN=${SENTRY_DSN}
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_DISK=linode
BACKUP_SCHEDULE="0 2 * * *"

# Auto-scaling Configuration
AUTO_SCALING_ENABLED=true
AUTO_SCALING_MIN_INSTANCES=1
AUTO_SCALING_MAX_INSTANCES=5
AUTO_SCALING_TARGET_CPU=70

# Vite (for asset compilation)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
