# Laravel Cloud Environment Configuration - Notification Service
# These variables are managed through the Laravel Cloud dashboard

# Application
APP_NAME="Notification Service"
APP_ENV=production
APP_KEY=${CLOUD_APP_KEY}
APP_DEBUG=false
APP_URL=https://notifications.yourdomain.com

# Database (Cloud-managed MySQL)
DB_CONNECTION=mysql
DB_HOST=${CLOUD_DB_HOST}
DB_PORT=${CLOUD_DB_PORT}
DB_DATABASE=${CLOUD_DB_DATABASE}
DB_USERNAME=${CLOUD_DB_USERNAME}
DB_PASSWORD=${CLOUD_DB_PASSWORD}

# SSL Configuration for Cloud Database
MYSQL_ATTR_SSL_CA=${CLOUD_DB_SSL_CA}
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# Cache (Cloud-managed Redis)
CACHE_DRIVER=redis
REDIS_HOST=${CLOUD_REDIS_HOST}
REDIS_PASSWORD=${CLOUD_REDIS_PASSWORD}
REDIS_PORT=${CLOUD_REDIS_PORT}
REDIS_DB=1

# Queue
QUEUE_CONNECTION=redis
REDIS_QUEUE=notifications

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com

# Service Configuration
SERVICE_PORT=8080
SERVICE_NAME=notification-service

# Email Configuration
MAIL_MAILER=smtp
MAIL_HOST=${CLOUD_MAIL_HOST}
MAIL_PORT=${CLOUD_MAIL_PORT}
MAIL_USERNAME=${CLOUD_MAIL_USERNAME}
MAIL_PASSWORD=${CLOUD_MAIL_PASSWORD}
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Your App"

# SMS Configuration (Twilio)
TWILIO_SID=${TWILIO_SID}
TWILIO_TOKEN=${TWILIO_TOKEN}
TWILIO_FROM=${TWILIO_FROM}

# Push Notifications (FCM)
FCM_SERVER_KEY=${FCM_SERVER_KEY}
FCM_PROJECT_ID=${FCM_PROJECT_ID}

# WhatsApp Configuration (Twilio)
WHATSAPP_SID=${WHATSAPP_SID}
WHATSAPP_TOKEN=${WHATSAPP_TOKEN}
WHATSAPP_FROM=${WHATSAPP_FROM}

# Telegram Configuration
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}

# Security
API_KEYS_SHARED_SERVICE=${CLOUD_INTERNAL_API_KEY}

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Broadcasting
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# File Storage (Cloud-managed S3)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=${CLOUD_S3_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${CLOUD_S3_SECRET_KEY}
AWS_DEFAULT_REGION=${CLOUD_S3_REGION}
AWS_BUCKET=${CLOUD_S3_BUCKET}
AWS_USE_PATH_STYLE_ENDPOINT=false

# Rate Limiting
RATE_LIMIT_EMAIL_PER_MINUTE=60
RATE_LIMIT_SMS_PER_MINUTE=30
RATE_LIMIT_PUSH_PER_MINUTE=100

# Template Configuration
TEMPLATE_CACHE_TTL=3600
TEMPLATE_DEFAULT_LANGUAGE=en

# Notification Retry Configuration
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY=300
NOTIFICATION_BATCH_SIZE=100

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_CACHE_TTL=30
HEALTH_CHECK_DATABASE_TIMEOUT=5
HEALTH_CHECK_REDIS_TIMEOUT=3

# Cloud-specific Configuration
CLOUD_ENVIRONMENT=production
CLOUD_REGION=us-east-1
CLOUD_SERVICE_NAME=notification-service

# Performance Configuration
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8080
OCTANE_WORKERS=auto
OCTANE_TASK_WORKERS=auto
OCTANE_MAX_REQUESTS=500

# Queue Worker Configuration
QUEUE_WORKER_TIMEOUT=60
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_BACKOFF=10

# Email Provider Configuration (Mailgun)
MAILGUN_DOMAIN=${MAILGUN_DOMAIN}
MAILGUN_SECRET=${MAILGUN_SECRET}
MAILGUN_ENDPOINT=api.mailgun.net

# Alternative Email Provider (SendGrid)
SENDGRID_API_KEY=${SENDGRID_API_KEY}

# Alternative Email Provider (SES)
SES_KEY=${SES_KEY}
SES_SECRET=${SES_SECRET}
SES_REGION=${SES_REGION}

# Monitoring and Metrics
METRICS_ENABLED=true
METRICS_DRIVER=cloudwatch
METRICS_NAMESPACE=notification-service

# Error Tracking (Sentry)
SENTRY_LARAVEL_DSN=${SENTRY_DSN}
SENTRY_TRACES_SAMPLE_RATE=0.1

# Telescope (if enabled for debugging)
TELESCOPE_ENABLED=false
TELESCOPE_DRIVER=database

# Horizon (for queue management)
HORIZON_ENABLED=true
HORIZON_PREFIX=notification-service
HORIZON_BALANCE=auto
HORIZON_MAX_PROCESSES=10

# Cache Tags (for advanced caching)
CACHE_TAGS_ENABLED=true

# Notification Channels Configuration
NOTIFICATION_CHANNELS_EMAIL=true
NOTIFICATION_CHANNELS_SMS=true
NOTIFICATION_CHANNELS_PUSH=true
NOTIFICATION_CHANNELS_WHATSAPP=true
NOTIFICATION_CHANNELS_TELEGRAM=true

# Webhook Configuration
WEBHOOK_ENABLED=true
WEBHOOK_SECRET=${WEBHOOK_SECRET}
WEBHOOK_TIMEOUT=30

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_SCHEDULE="0 2 * * *"

# Vite (for asset compilation)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
