# Laravel Cloud Environment Configuration - Shared Service
# These variables are managed through the Laravel Cloud dashboard

# Application
APP_NAME="Shared Service"
APP_ENV=production
APP_KEY=${CLOUD_APP_KEY}
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

# Database (Cloud-managed MySQL)
DB_CONNECTION=mysql
DB_HOST=${CLOUD_DB_HOST}
DB_PORT=${CLOUD_DB_PORT}
DB_DATABASE=${CLOUD_DB_DATABASE}
DB_USERNAME=${CLOUD_DB_USERNAME}
DB_PASSWORD=${CLOUD_DB_PASSWORD}

# SSL Configuration for Cloud Database
MYSQL_ATTR_SSL_CA=${CLOUD_DB_SSL_CA}
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# Cache (Cloud-managed Redis)
CACHE_DRIVER=redis
REDIS_HOST=${CLOUD_REDIS_HOST}
REDIS_PASSWORD=${CLOUD_REDIS_PASSWORD}
REDIS_PORT=${CLOUD_REDIS_PORT}
REDIS_DB=0

# Queue
QUEUE_CONNECTION=redis
REDIS_QUEUE=default

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com

# Notification Service Configuration
NOTIFICATION_SERVICE_URL=https://notification-service.internal.cloud.laravel.com
NOTIFICATION_SERVICE_API_KEY=${CLOUD_INTERNAL_API_KEY}
NOTIFICATION_SERVICE_TIMEOUT=30
NOTIFICATION_SERVICE_RETRIES=3
NOTIFICATION_SERVICE_HEALTH_URL=https://notification-service.internal.cloud.laravel.com/api/health

# Service Communication
SERVICE_COMMUNICATION_METHOD=http
CIRCUIT_BREAKER_THRESHOLD=10
CIRCUIT_BREAKER_TIMEOUT=60

# Monitoring
TRACE_SERVICE_REQUESTS=true
SERVICE_LOG_LEVEL=info
SERVICE_METRICS_ENABLED=true

# Security
API_KEYS_NOTIFICATION_SERVICE=${CLOUD_INTERNAL_API_KEY}

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Broadcasting
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Mail (for system notifications)
MAIL_MAILER=smtp
MAIL_HOST=${CLOUD_MAIL_HOST}
MAIL_PORT=${CLOUD_MAIL_PORT}
MAIL_USERNAME=${CLOUD_MAIL_USERNAME}
MAIL_PASSWORD=${CLOUD_MAIL_PASSWORD}
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=system@yourdomain.com
MAIL_FROM_NAME="Shared Service"

# File Storage (Cloud-managed S3)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=${CLOUD_S3_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${CLOUD_S3_SECRET_KEY}
AWS_DEFAULT_REGION=${CLOUD_S3_REGION}
AWS_BUCKET=${CLOUD_S3_BUCKET}
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum (API Authentication)
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,*.yourdomain.com,*.cloud.laravel.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com,https://*.cloud.laravel.com

# Rate Limiting
THROTTLE_REQUESTS_PER_MINUTE=60
THROTTLE_LOGIN_ATTEMPTS=5

# Cloud-specific Configuration
CLOUD_ENVIRONMENT=production
CLOUD_REGION=us-east-1
CLOUD_SERVICE_NAME=shared-service

# Health Check Configuration
HEALTH_CHECK_CACHE_TTL=30
HEALTH_CHECK_DATABASE_TIMEOUT=5
HEALTH_CHECK_REDIS_TIMEOUT=3

# Performance Configuration
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000
OCTANE_WORKERS=auto
OCTANE_TASK_WORKERS=auto
OCTANE_MAX_REQUESTS=500

# Telescope (if enabled for debugging)
TELESCOPE_ENABLED=false
TELESCOPE_DRIVER=database

# Horizon (if using for queue management)
HORIZON_ENABLED=false
HORIZON_PREFIX=shared-service

# Vite (for asset compilation)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
