# 🗄️ Database Configuration for Laravel Reverse Tender Platform
# Copy this file to .env.database and update with your actual credentials

# =============================================================================
# PRIMARY DATABASE - NEON POSTGRESQL (Production)
# =============================================================================
NEON_DATABASE_URL=postgresql://username:password@ep-example.us-east-1.aws.neon.tech/larvrevrstender_primary?sslmode=require
NEON_DB_HOST=ep-example.us-east-1.aws.neon.tech
NEON_DB_PORT=5432
NEON_DB_DATABASE=larvrevrstender_primary
NEON_DB_USERNAME=your_neon_username
NEON_DB_PASSWORD=your_neon_password

# =============================================================================
# SECONDARY DATABASE - CLOUD POSTGRESQL (Backup)
# =============================================================================
CLOUD_DATABASE_URL=postgresql://username:password@your-cloud-postgres.amazonaws.com:5432/larvrevrstender_secondary
CLOUD_DB_HOST=your-cloud-postgres.amazonaws.com
CLOUD_DB_PORT=5432
CLOUD_DB_DATABASE=larvrevrstender_secondary
CLOUD_DB_USERNAME=your_cloud_username
CLOUD_DB_PASSWORD=your_cloud_password

# =============================================================================
# FALLBACK DATABASE - MONGODB ATLAS
# =============================================================================
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/larvrevrstender_fallback?retryWrites=true&w=majority
MONGODB_HOST=cluster0.example.mongodb.net
MONGODB_PORT=27017
MONGODB_DATABASE=larvrevrstender_fallback
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password

# =============================================================================
# LOCAL DEVELOPMENT DATABASES
# =============================================================================
# Primary PostgreSQL (Local)
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=larvrevrstender_primary
DB_USERNAME=larvrevrstender
DB_PASSWORD=secure_password_123

# Secondary PostgreSQL (Local)
DB_SECONDARY_HOST=localhost
DB_SECONDARY_PORT=5433
DB_SECONDARY_DATABASE=larvrevrstender_secondary
DB_SECONDARY_USERNAME=larvrevrstender
DB_SECONDARY_PASSWORD=secure_password_123

# MongoDB (Local)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=larvrevrstender_fallback
MONGO_USERNAME=larvrevrstender
MONGO_PASSWORD=secure_password_123

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Redis for Sessions
SESSION_DRIVER=redis
SESSION_CONNECTION=default

# Redis for Caching
CACHE_DRIVER=redis
CACHE_CONNECTION=default

# Redis for Queues
QUEUE_CONNECTION=redis
QUEUE_REDIS_CONNECTION=default

# =============================================================================
# DATABASE ADMINISTRATION
# =============================================================================
# PgAdmin
PGADMIN_PASSWORD=admin_password_123

# Mongo Express
MONGO_EXPRESS_PASSWORD=admin_password_123

# =============================================================================
# SERVICE-SPECIFIC DATABASE CONFIGURATIONS
# =============================================================================

# Auth Service
AUTH_DB_HOST=${DB_HOST}
AUTH_DB_PORT=${DB_PORT}
AUTH_DB_DATABASE=auth_service
AUTH_DB_USERNAME=auth_service_user
AUTH_DB_PASSWORD=auth_service_password_123

# User Service
USER_DB_HOST=${DB_HOST}
USER_DB_PORT=${DB_PORT}
USER_DB_DATABASE=user_service
USER_DB_USERNAME=user_service_user
USER_DB_PASSWORD=user_service_password_123

# Auction Service
AUCTION_DB_HOST=${DB_HOST}
AUCTION_DB_PORT=${DB_PORT}
AUCTION_DB_DATABASE=auction_service
AUCTION_DB_USERNAME=auction_service_user
AUCTION_DB_PASSWORD=auction_service_password_123

# Bidding Service
BIDDING_DB_HOST=${DB_HOST}
BIDDING_DB_PORT=${DB_PORT}
BIDDING_DB_DATABASE=bidding_service
BIDDING_DB_USERNAME=bidding_service_user
BIDDING_DB_PASSWORD=bidding_service_password_123

# Payment Service
PAYMENT_DB_HOST=${DB_HOST}
PAYMENT_DB_PORT=${DB_PORT}
PAYMENT_DB_DATABASE=payment_service
PAYMENT_DB_USERNAME=payment_service_user
PAYMENT_DB_PASSWORD=payment_service_password_123

# Order Service
ORDER_DB_HOST=${DB_HOST}
ORDER_DB_PORT=${DB_PORT}
ORDER_DB_DATABASE=order_service
ORDER_DB_USERNAME=order_service_user
ORDER_DB_PASSWORD=order_service_password_123

# Notification Service
NOTIFICATION_DB_HOST=${DB_HOST}
NOTIFICATION_DB_PORT=${DB_PORT}
NOTIFICATION_DB_DATABASE=notification_service
NOTIFICATION_DB_USERNAME=notification_service_user
NOTIFICATION_DB_PASSWORD=notification_service_password_123

# Analytics Service
ANALYTICS_DB_HOST=${DB_HOST}
ANALYTICS_DB_PORT=${DB_PORT}
ANALYTICS_DB_DATABASE=analytics_service
ANALYTICS_DB_USERNAME=analytics_service_user
ANALYTICS_DB_PASSWORD=analytics_service_password_123

# Gateway Service
GATEWAY_DB_HOST=${DB_HOST}
GATEWAY_DB_PORT=${DB_PORT}
GATEWAY_DB_DATABASE=gateway_service
GATEWAY_DB_USERNAME=gateway_service_user
GATEWAY_DB_PASSWORD=gateway_service_password_123

# VIN OCR Service
VIN_OCR_DB_HOST=${DB_HOST}
VIN_OCR_DB_PORT=${DB_PORT}
VIN_OCR_DB_DATABASE=vin_ocr_service
VIN_OCR_DB_USERNAME=vin_ocr_service_user
VIN_OCR_DB_PASSWORD=vin_ocr_service_password_123

# Shared Service
SHARED_DB_HOST=${DB_HOST}
SHARED_DB_PORT=${DB_PORT}
SHARED_DB_DATABASE=shared_service
SHARED_DB_USERNAME=shared_service_user
SHARED_DB_PASSWORD=shared_service_password_123

# =============================================================================
# DATABASE FAILOVER CONFIGURATION
# =============================================================================
DB_FAILOVER_ENABLED=true
DB_FAILOVER_TIMEOUT=5
DB_FAILOVER_RETRY_ATTEMPTS=3
DB_HEALTH_CHECK_INTERVAL=30

# Primary -> Secondary -> MongoDB fallback order
DB_FAILOVER_ORDER=primary,secondary,mongodb

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
DB_QUERY_LOG_ENABLED=true
DB_SLOW_QUERY_LOG_ENABLED=true
DB_SLOW_QUERY_THRESHOLD=1000
DB_CONNECTION_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30
