# Staging Environment Configuration for Reverse Tender Platform
# Updated for comprehensive database failover architecture v3.0

# Application Configuration
APP_ENV=staging
APP_DEBUG=true
APP_URL=https://staging.reversetender.com
LOG_LEVEL=debug

# =============================================================================
# DATABASE FAILOVER CONFIGURATION - STAGING
# =============================================================================

# Enable database failover for staging testing
DB_FAILOVER_ENABLED=true
DB_FAILOVER_STRATEGY=primary-secondary-tertiary

# Production-like timeouts for staging
DB_FAILOVER_TIMEOUT=30
DB_FAILOVER_RETRY_ATTEMPTS=3
DB_FAILOVER_RETRY_DELAY=5

# Standard health check intervals
DB_FAILOVER_HEALTH_CHECK_INTERVAL=30

# Circuit breaker with production-like settings
DB_FAILOVER_CIRCUIT_BREAKER_ENABLED=true
DB_FAILOVER_CIRCUIT_BREAKER_THRESHOLD=5
DB_FAILOVER_CIRCUIT_BREAKER_TIMEOUT=60

# Primary Database: Neon PostgreSQL (Staging Branch)
DB_PRIMARY_PROVIDER=neon
NEON_ENABLED=true
NEON_COMPUTE_SIZE=0.5
NEON_MIN_COMPUTE_SIZE=0.25
NEON_MAX_COMPUTE_SIZE=2
NEON_BRANCH_ENABLED=true
NEON_ACTIVE_BRANCH=staging
DB_PRIMARY_POOL_SIZE=10

# Secondary Database: CNPG PostgreSQL (Staging Cluster)
DB_SECONDARY_PROVIDER=cnpg
CNPG_ENABLED=true
CNPG_CLUSTER_NAME=reverse-tender-postgres-staging
CNPG_INSTANCES=2
CNPG_STORAGE_SIZE=50Gi
CNPG_MEMORY_REQUEST=512Mi
CNPG_MEMORY_LIMIT=1Gi
CNPG_CPU_REQUEST=250m
CNPG_CPU_LIMIT=500m
DB_SECONDARY_POOL_SIZE=8

# Tertiary Database: MongoDB Atlas (Staging Cluster)
DB_TERTIARY_PROVIDER=mongodb-atlas
MONGODB_ATLAS_ENABLED=true
MONGODB_ATLAS_CLUSTER_NAME=reverse-tender-staging
MONGODB_ATLAS_TIER=M2
MONGODB_ATLAS_REGION=US_EAST_1
DB_TERTIARY_POOL_SIZE=5

# Enhanced monitoring for staging
DB_MONITORING_ENABLED=true
DB_METRICS_ENABLED=true
DB_SLOW_QUERY_LOG=true
DB_SLOW_QUERY_THRESHOLD=500

# Legacy Database Configuration (for backward compatibility)
DB_HOST=mysql-primary
DB_USERNAME=staging_user
DB_PASSWORD=${STAGING_DB_PASSWORD}

# Redis Configuration
REDIS_HOST=redis-primary
REDIS_PASSWORD=${STAGING_REDIS_PASSWORD}

# MySQL Configuration
MYSQL_ROOT_PASSWORD=${STAGING_MYSQL_ROOT_PASSWORD}

# Security Configuration
JWT_SECRET=${STAGING_JWT_SECRET}
APP_KEY=${STAGING_APP_KEY}

# Third-party Services (Sandbox/Test)
SMS_PROVIDER=unifonic
UNIFONIC_API_KEY=${STAGING_UNIFONIC_API_KEY}
UNIFONIC_SENDER_ID=${STAGING_UNIFONIC_SENDER_ID}
MSEGAT_API_KEY=${STAGING_MSEGAT_API_KEY}
MSEGAT_USERNAME=${STAGING_MSEGAT_USERNAME}
SENDGRID_API_KEY=${STAGING_SENDGRID_API_KEY}

# Cloud Storage Configuration (Staging)
# DigitalOcean Spaces Configuration
DO_SPACES_BUCKET=${STAGING_DO_SPACES_BUCKET}
DO_SPACES_ACCESS_KEY=${STAGING_DO_SPACES_ACCESS_KEY}
DO_SPACES_SECRET_KEY=${STAGING_DO_SPACES_SECRET_KEY}
DO_SPACES_REGION=${STAGING_DO_SPACES_REGION}
DO_SPACES_ENDPOINT=https://${STAGING_DO_SPACES_REGION}.digitaloceanspaces.com

# Linode Object Storage Configuration
LINODE_BUCKET=${STAGING_LINODE_BUCKET}
LINODE_ACCESS_KEY=${STAGING_LINODE_ACCESS_KEY}
LINODE_SECRET_KEY=${STAGING_LINODE_SECRET_KEY}
LINODE_REGION=${STAGING_LINODE_REGION}
LINODE_ENDPOINT=https://${STAGING_LINODE_REGION}.linodeobjects.com

# Active Storage Provider (digitalocean or linode)
STORAGE_PROVIDER=${STAGING_STORAGE_PROVIDER}

# S3-Compatible Configuration (Auto-configured based on provider)
S3_BUCKET=${STAGING_STORAGE_PROVIDER == "digitalocean" ? STAGING_DO_SPACES_BUCKET : STAGING_LINODE_BUCKET}
S3_ACCESS_KEY=${STAGING_STORAGE_PROVIDER == "digitalocean" ? STAGING_DO_SPACES_ACCESS_KEY : STAGING_LINODE_ACCESS_KEY}
S3_SECRET_KEY=${STAGING_STORAGE_PROVIDER == "digitalocean" ? STAGING_DO_SPACES_SECRET_KEY : STAGING_LINODE_SECRET_KEY}
S3_REGION=${STAGING_STORAGE_PROVIDER == "digitalocean" ? STAGING_DO_SPACES_REGION : STAGING_LINODE_REGION}
S3_ENDPOINT=${STAGING_STORAGE_PROVIDER == "digitalocean" ? DO_SPACES_ENDPOINT : LINODE_ENDPOINT}

# AWS SDK Configuration (for S3-compatible services)
AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${S3_SECRET_KEY}
AWS_DEFAULT_REGION=${S3_REGION}
AWS_BUCKET=${S3_BUCKET}
AWS_ENDPOINT=${S3_ENDPOINT}
AWS_USE_PATH_STYLE_ENDPOINT=true

# CDN Configuration (DigitalOcean only)
CDN_ENABLED=false
CDN_ENDPOINT=${STAGING_CDN_ENDPOINT}

# Storage Security (Staging)
STORAGE_ENCRYPTION_ENABLED=true
STORAGE_VERSIONING_ENABLED=true
STORAGE_BACKUP_ENABLED=false

# Payment Gateway (Sandbox)
ZATCA_API_URL=${STAGING_ZATCA_API_URL}
ZATCA_API_KEY=${STAGING_ZATCA_API_KEY}
ZATCA_CERTIFICATE=${STAGING_ZATCA_CERTIFICATE}
PAYMENT_GATEWAY_URL=${STAGING_PAYMENT_GATEWAY_URL}
PAYMENT_GATEWAY_KEY=${STAGING_PAYMENT_GATEWAY_KEY}

# Push Notifications (Test)
FCM_SERVER_KEY=${STAGING_FCM_SERVER_KEY}
APNS_KEY_ID=${STAGING_APNS_KEY_ID}
APNS_TEAM_ID=${STAGING_APNS_TEAM_ID}

# Google Cloud Services (Test)
GOOGLE_CLOUD_VISION_KEY=${STAGING_GOOGLE_CLOUD_VISION_KEY}

# Monitoring
GRAFANA_PASSWORD=${STAGING_GRAFANA_PASSWORD}
GRAFANA_ADMIN_USER=staging_admin

# SSL Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/staging.reversetender.crt
SSL_KEY_PATH=/etc/ssl/private/staging.reversetender.key

# Laravel Octane Configuration (Staging)
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
OCTANE_WORKERS=3
OCTANE_TASK_WORKERS=4
OCTANE_MAX_REQUESTS=250
OCTANE_MEMORY_LIMIT=384M
OCTANE_WATCH=false

# FrankenPHP Configuration (Staging)
FRANKENPHP_WORKER_MODE=true
FRANKENPHP_NUM_THREADS=3
FRANKENPHP_DEBUG=false

# Performance Configuration (Staging)
PHP_OPCACHE_ENABLE=1
PHP_OPCACHE_MEMORY_CONSUMPTION=192
PHP_OPCACHE_MAX_ACCELERATED_FILES=15000
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
PHP_OPCACHE_REVALIDATE_FREQ=60
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 4 * * *"
BACKUP_RETENTION_DAYS=7

# Rate Limiting (More permissive for testing)
API_RATE_LIMIT=500
API_RATE_LIMIT_WINDOW=1

# Session Configuration
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# CORS Configuration (More permissive for testing)
CORS_ALLOWED_ORIGINS=https://staging.reversetender.com,http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-Debug-Token

# Error Reporting
SENTRY_DSN=${STAGING_SENTRY_DSN}
ERROR_REPORTING_ENABLED=true

# Testing Configuration
TESTING_ENABLED=true
MOCK_EXTERNAL_SERVICES=true
FAKE_NOTIFICATIONS=true
