# Production Environment Configuration for Reverse Tender Platform

# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_URL=https://reversetender.com
LOG_LEVEL=warning

# Database Configuration
DB_HOST=mysql-primary
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

# Redis Configuration
REDIS_HOST=redis-primary
REDIS_PASSWORD=${REDIS_PASSWORD}

# MySQL Configuration
MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}

# Security Configuration
JWT_SECRET=${JWT_SECRET}
APP_KEY=${APP_KEY}

# Third-party Services
SMS_PROVIDER=unifonic
UNIFONIC_API_KEY=${UNIFONIC_API_KEY}
UNIFONIC_SENDER_ID=${UNIFONIC_SENDER_ID}
MSEGAT_API_KEY=${MSEGAT_API_KEY}
MSEGAT_USERNAME=${MSEGAT_USERNAME}
OURSMS_API_KEY=${OURSMS_API_KEY}
OURSMS_SENDER_ID=${OURSMS_SENDER_ID}
INFOBIP_API_KEY=${INFOBIP_API_KEY}
INFOBIP_BASE_URL=${INFOBIP_BASE_URL}
SENDGRID_API_KEY=${SENDGRID_API_KEY}

# Cloud Storage Configuration
# DigitalOcean Spaces Configuration
DO_SPACES_BUCKET=${DO_SPACES_BUCKET}
DO_SPACES_ACCESS_KEY=${DO_SPACES_ACCESS_KEY}
DO_SPACES_SECRET_KEY=${DO_SPACES_SECRET_KEY}
DO_SPACES_REGION=${DO_SPACES_REGION}
DO_SPACES_ENDPOINT=https://${DO_SPACES_REGION}.digitaloceanspaces.com

# Linode Object Storage Configuration
LINODE_BUCKET=${LINODE_BUCKET}
LINODE_ACCESS_KEY=${LINODE_ACCESS_KEY}
LINODE_SECRET_KEY=${LINODE_SECRET_KEY}
LINODE_REGION=${LINODE_REGION}
LINODE_ENDPOINT=https://${LINODE_REGION}.linodeobjects.com

# Active Storage Provider (digitalocean or linode)
STORAGE_PROVIDER=${STORAGE_PROVIDER}

# S3-Compatible Configuration (Auto-configured based on provider)
S3_BUCKET=${STORAGE_PROVIDER == "digitalocean" ? DO_SPACES_BUCKET : LINODE_BUCKET}
S3_ACCESS_KEY=${STORAGE_PROVIDER == "digitalocean" ? DO_SPACES_ACCESS_KEY : LINODE_ACCESS_KEY}
S3_SECRET_KEY=${STORAGE_PROVIDER == "digitalocean" ? DO_SPACES_SECRET_KEY : LINODE_SECRET_KEY}
S3_REGION=${STORAGE_PROVIDER == "digitalocean" ? DO_SPACES_REGION : LINODE_REGION}
S3_ENDPOINT=${STORAGE_PROVIDER == "digitalocean" ? DO_SPACES_ENDPOINT : LINODE_ENDPOINT}

# AWS SDK Configuration (for S3-compatible services)
AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${S3_SECRET_KEY}
AWS_DEFAULT_REGION=${S3_REGION}
AWS_BUCKET=${S3_BUCKET}
AWS_ENDPOINT=${S3_ENDPOINT}
AWS_USE_PATH_STYLE_ENDPOINT=true

# CDN Configuration (DigitalOcean only)
CDN_ENABLED=${CDN_ENABLED}
CDN_ENDPOINT=${CDN_ENDPOINT}
CDN_CUSTOM_DOMAIN=${CDN_CUSTOM_DOMAIN}

# Storage Security
STORAGE_ENCRYPTION_ENABLED=true
STORAGE_VERSIONING_ENABLED=true
STORAGE_BACKUP_ENABLED=true

# Payment Gateway
ZATCA_API_URL=${ZATCA_API_URL}
ZATCA_API_KEY=${ZATCA_API_KEY}
ZATCA_CERTIFICATE=${ZATCA_CERTIFICATE}
PAYMENT_GATEWAY_URL=${PAYMENT_GATEWAY_URL}
PAYMENT_GATEWAY_KEY=${PAYMENT_GATEWAY_KEY}

# Push Notifications
FCM_SERVER_KEY=${FCM_SERVER_KEY}
APNS_KEY_ID=${APNS_KEY_ID}
APNS_TEAM_ID=${APNS_TEAM_ID}

# Google Cloud Services
GOOGLE_CLOUD_VISION_KEY=${GOOGLE_CLOUD_VISION_KEY}

# Monitoring
GRAFANA_PASSWORD=${GRAFANA_PASSWORD}
GRAFANA_ADMIN_USER=admin

# SSL Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/reversetender.crt
SSL_KEY_PATH=/etc/ssl/private/reversetender.key

# Laravel Octane Configuration (Production)
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
OCTANE_WORKERS=4
OCTANE_TASK_WORKERS=6
OCTANE_MAX_REQUESTS=500
OCTANE_MEMORY_LIMIT=512M
OCTANE_WATCH=false

# FrankenPHP Configuration (Production)
FRANKENPHP_WORKER_MODE=true
FRANKENPHP_NUM_THREADS=4
FRANKENPHP_DEBUG=false

# Performance Configuration (Production)
PHP_OPCACHE_ENABLE=1
PHP_OPCACHE_MEMORY_CONSUMPTION=256
PHP_OPCACHE_MAX_ACCELERATED_FILES=20000
PHP_OPCACHE_VALIDATE_TIMESTAMPS=0
PHP_OPCACHE_REVALIDATE_FREQ=0
REDIS_MAXMEMORY=1gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Rate Limiting
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=1

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://reversetender.com,https://www.reversetender.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Error Reporting
SENTRY_DSN=${SENTRY_DSN}
ERROR_REPORTING_ENABLED=true
