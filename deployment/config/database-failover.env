# Database Failover Configuration for Reverse Tender Platform
# Updated for comprehensive database failover architecture v3.0
# Supports: Neon PostgreSQL, Cloud-Native PostgreSQL, MongoDB Atlas

# =============================================================================
# DATABASE FAILOVER STRATEGY CONFIGURATION
# =============================================================================

# Enable/disable database failover
DB_FAILOVER_ENABLED=true

# Failover strategy: primary-secondary-tertiary, round-robin, priority-based
DB_FAILOVER_STRATEGY=primary-secondary-tertiary

# Failover timeout in seconds
DB_FAILOVER_TIMEOUT=30

# Number of retry attempts before switching to next provider
DB_FAILOVER_RETRY_ATTEMPTS=3

# Delay between retry attempts in seconds
DB_FAILOVER_RETRY_DELAY=5

# Health check interval for database monitoring
DB_FAILOVER_HEALTH_CHECK_INTERVAL=10

# =============================================================================
# CIRCUIT BREAKER CONFIGURATION
# =============================================================================

# Enable circuit breaker pattern for database connections
DB_FAILOVER_CIRCUIT_BREAKER_ENABLED=true

# Number of failures before circuit breaker opens
DB_FAILOVER_CIRCUIT_BREAKER_THRESHOLD=5

# Circuit breaker timeout in seconds before attempting to close
DB_FAILOVER_CIRCUIT_BREAKER_TIMEOUT=60

# Circuit breaker half-open state max requests
DB_FAILOVER_CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=3

# =============================================================================
# PRIMARY DATABASE: NEON POSTGRESQL CONFIGURATION
# =============================================================================

# Primary database provider
DB_PRIMARY_PROVIDER=neon
DB_PRIMARY_TYPE=postgresql
DB_PRIMARY_CONNECTION=pgsql
DB_PRIMARY_PORT=5432
DB_PRIMARY_CHARSET=utf8
DB_PRIMARY_COLLATION=utf8_unicode_ci
DB_PRIMARY_SSLMODE=require

# Neon PostgreSQL specific configuration
NEON_ENABLED=true
NEON_REGION=us-east-1
NEON_COMPUTE_SIZE=0.25
NEON_AUTOSCALING_ENABLED=true
NEON_MIN_COMPUTE_SIZE=0.25
NEON_MAX_COMPUTE_SIZE=4
NEON_SUSPEND_TIMEOUT=300
NEON_POOLER_ENABLED=true
NEON_POOLER_MODE=transaction
NEON_POOLER_SIZE=25
NEON_SSL_MODE=require
NEON_CONNECTION_LIMIT=100

# Neon branch configuration
NEON_BRANCH_ENABLED=true
NEON_MAIN_BRANCH=main
NEON_DEV_BRANCH=dev
NEON_STAGING_BRANCH=staging

# Primary database connection pool settings
DB_PRIMARY_POOL_SIZE=20
DB_PRIMARY_POOL_TIMEOUT=30
DB_PRIMARY_IDLE_TIMEOUT=300
DB_PRIMARY_MAX_LIFETIME=3600

# =============================================================================
# SECONDARY DATABASE: CLOUD-NATIVE POSTGRESQL (CNPG) CONFIGURATION
# =============================================================================

# Secondary database provider
DB_SECONDARY_PROVIDER=cnpg
DB_SECONDARY_TYPE=postgresql
DB_SECONDARY_CONNECTION=pgsql
DB_SECONDARY_PORT=5432
DB_SECONDARY_CHARSET=utf8
DB_SECONDARY_COLLATION=utf8_unicode_ci
DB_SECONDARY_SSLMODE=prefer

# CNPG cluster configuration
CNPG_ENABLED=true
CNPG_CLUSTER_NAME=reverse-tender-postgres
CNPG_INSTANCES=3
CNPG_PRIMARY_UPDATE_STRATEGY=unsupervised
CNPG_POSTGRESQL_VERSION=16
CNPG_STORAGE_CLASS=fast-ssd
CNPG_STORAGE_SIZE=100Gi
CNPG_MEMORY_REQUEST=1Gi
CNPG_MEMORY_LIMIT=2Gi
CNPG_CPU_REQUEST=500m
CNPG_CPU_LIMIT=1000m

# CNPG replication configuration
CNPG_REPLICA_CLUSTER_ENABLED=true
CNPG_REPLICA_INSTANCES=2
CNPG_STREAMING_REPLICATION=true
CNPG_SYNCHRONOUS_REPLICATION=false
CNPG_MAX_REPLICATION_SLOTS=10
CNPG_MAX_WAL_SENDERS=10

# CNPG backup configuration
CNPG_BACKUP_ENABLED=true
CNPG_BACKUP_SCHEDULE="0 2 * * *"
CNPG_BACKUP_RETENTION_POLICY=30d
CNPG_WAL_RETENTION_POLICY=7d
CNPG_BACKUP_COMPRESSION=gzip

# Secondary database connection pool settings
DB_SECONDARY_POOL_SIZE=15
DB_SECONDARY_POOL_TIMEOUT=30
DB_SECONDARY_IDLE_TIMEOUT=300
DB_SECONDARY_MAX_LIFETIME=3600

# =============================================================================
# TERTIARY DATABASE: MONGODB ATLAS CONFIGURATION
# =============================================================================

# Tertiary database provider
DB_TERTIARY_PROVIDER=mongodb-atlas
DB_TERTIARY_TYPE=mongodb
DB_TERTIARY_CONNECTION=mongodb
DB_TERTIARY_PORT=27017
DB_TERTIARY_AUTH_SOURCE=admin
DB_TERTIARY_REPLICA_SET=atlas-replica-set
DB_TERTIARY_SSL=true

# MongoDB Atlas configuration
MONGODB_ATLAS_ENABLED=true
MONGODB_ATLAS_CLUSTER_NAME=reverse-tender-cluster
MONGODB_ATLAS_REGION=US_EAST_1
MONGODB_ATLAS_TIER=M10
MONGODB_ATLAS_VERSION=7.0
MONGODB_ATLAS_REPLICA_SET_ENABLED=true
MONGODB_ATLAS_REPLICA_SET_SIZE=3
MONGODB_ATLAS_BACKUP_ENABLED=true
MONGODB_ATLAS_BACKUP_POLICY=DAILY
MONGODB_ATLAS_BACKUP_RETENTION=30

# MongoDB connection configuration
MONGODB_AUTH_SOURCE=admin
MONGODB_SSL_ENABLED=true
MONGODB_SSL_VALIDATE=true
MONGODB_RETRY_WRITES=true
MONGODB_RETRY_READS=true
MONGODB_READ_PREFERENCE=primaryPreferred
MONGODB_WRITE_CONCERN=majority
MONGODB_READ_CONCERN=majority

# Tertiary database connection pool settings
DB_TERTIARY_POOL_SIZE=10
DB_TERTIARY_POOL_TIMEOUT=30
DB_TERTIARY_SERVER_SELECTION_TIMEOUT=30000
DB_TERTIARY_SOCKET_TIMEOUT=30000

# =============================================================================
# DATABASE HEALTH CHECK CONFIGURATION
# =============================================================================

# Enable database health checks
DB_HEALTH_CHECK_ENABLED=true

# Health check interval in seconds
DB_HEALTH_CHECK_INTERVAL=30

# Health check timeout in seconds
DB_HEALTH_CHECK_TIMEOUT=10

# Number of health check retries before marking as unhealthy
DB_HEALTH_CHECK_RETRIES=3

# Health check endpoint path
DB_HEALTH_CHECK_ENDPOINT=/health/database

# =============================================================================
# CONNECTION POOL CONFIGURATION
# =============================================================================

# Enable connection pooling
DB_POOL_ENABLED=true

# Minimum number of connections in pool
DB_POOL_MIN_CONNECTIONS=5

# Maximum number of connections in pool
DB_POOL_MAX_CONNECTIONS=50

# Connection acquisition timeout in milliseconds
DB_POOL_ACQUIRE_TIMEOUT=30000

# Connection creation timeout in milliseconds
DB_POOL_CREATE_TIMEOUT=30000

# Connection destruction timeout in milliseconds
DB_POOL_DESTROY_TIMEOUT=5000

# Connection idle timeout in milliseconds
DB_POOL_IDLE_TIMEOUT=300000

# Connection pool reaper interval in milliseconds
DB_POOL_REAP_INTERVAL=1000

# =============================================================================
# DATABASE MIGRATION CONFIGURATION
# =============================================================================

# Enable database migrations
DB_MIGRATION_ENABLED=true

# Migration timeout in seconds
DB_MIGRATION_TIMEOUT=300

# Migration lock timeout in seconds
DB_MIGRATION_LOCK_TIMEOUT=60

# Migration table name
DB_MIGRATION_TABLE=migrations

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Enable database backups
DB_BACKUP_ENABLED=true

# Backup schedule (cron format)
DB_BACKUP_SCHEDULE="0 2 * * *"

# Backup retention in days
DB_BACKUP_RETENTION_DAYS=30

# Backup compression algorithm
DB_BACKUP_COMPRESSION=gzip

# =============================================================================
# MONITORING AND LOGGING CONFIGURATION
# =============================================================================

# Enable database monitoring
DB_MONITORING_ENABLED=true

# Enable metrics collection
DB_METRICS_ENABLED=true

# Enable slow query logging
DB_SLOW_QUERY_LOG=true

# Slow query threshold in milliseconds
DB_SLOW_QUERY_THRESHOLD=1000

# Enable connection logging
DB_CONNECTION_LOG=true

# Enable error logging
DB_ERROR_LOG=true

# =============================================================================
# CACHE CONFIGURATION FOR DATABASE QUERIES
# =============================================================================

# Enable database query caching
DB_CACHE_ENABLED=true

# Cache TTL in seconds
DB_CACHE_TTL=300

# Cache key prefix
DB_CACHE_PREFIX=db_cache

# Enable query result caching
DB_QUERY_CACHE_ENABLED=true

# Query cache TTL in seconds
DB_QUERY_CACHE_TTL=600

# =============================================================================
# WEBHOOK AND NOTIFICATION CONFIGURATION
# =============================================================================

# Enable webhook notifications for failover events
DB_FAILOVER_WEBHOOK_ENABLED=true

# Webhook notification timeout in seconds
DB_FAILOVER_WEBHOOK_TIMEOUT=10

# Enable email notifications for failover events
DB_FAILOVER_EMAIL_ENABLED=true

# Enable Slack notifications for failover events
DB_FAILOVER_SLACK_ENABLED=true

# =============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =============================================================================

# These values can be overridden in environment-specific files:
# - deployment/config/environments/development.env
# - deployment/config/environments/staging.env
# - deployment/config/environments/production.env

# Development environment typically uses:
# - Neon PostgreSQL with smaller compute size
# - Reduced connection pool sizes
# - More verbose logging

# Staging environment typically uses:
# - Production-like configuration
# - Reduced resource limits
# - Enhanced monitoring

# Production environment typically uses:
# - All providers enabled
# - Maximum resource allocation
# - Comprehensive monitoring and alerting
