# Neon PostgreSQL Configuration Template
# Copy this file to your environment configuration and fill in your Neon credentials

# =============================================================================
# NEON POSTGRESQL CONFIGURATION
# =============================================================================

# Primary connection method (recommended)
# Get this from your Neon dashboard: https://console.neon.tech/
# Format: postgresql://username:password@hostname:port/database?sslmode=require
NEON_DATABASE_URL=postgresql://username:password@ep-autumn-morning-12345.us-east-1.neon.tech:5432/neondb?sslmode=require

# Individual connection parameters (fallback/legacy support)
# These are extracted from the connection URL above
NEON_DB_HOST=ep-autumn-morning-12345.us-east-1.neon.tech
NEON_DB_DATABASE=neondb
NEON_DB_USERNAME=username
NEON_DB_PASSWORD=password

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Create a Neon account at https://neon.com/
# 2. Create a new project in the Neon dashboard
# 3. Copy your connection string from the dashboard
# 4. Replace the example values above with your actual credentials
# 5. Add these variables to your deployment environment

# =============================================================================
# CONNECTION URL FORMAT
# =============================================================================

# Standard PostgreSQL connection string format:
# postgresql://[username[:password]@][host[:port]][/database][?option=value...]

# Neon-specific example:
# postgresql://neonuser:securepassword@ep-autumn-morning-12345.us-east-1.neon.tech:5432/neondb?sslmode=require

# URL Components:
# - Scheme: postgresql:// (or postgres://)
# - Username: Your Neon user account
# - Password: Your Neon password
# - Host: Neon endpoint (format: ep-*.neon.tech)
# - Port: 5432 (default PostgreSQL port)
# - Database: Database name within your Neon project
# - Query Parameters:
#   - sslmode=require: Enforces TLS/SSL encryption (recommended)

# =============================================================================
# SECURITY NOTES
# =============================================================================

# - Never commit actual credentials to version control
# - Use environment variables in all deployments
# - Enable SSL/TLS via sslmode=require
# - Rotate credentials periodically
# - Monitor connection usage in Neon dashboard
