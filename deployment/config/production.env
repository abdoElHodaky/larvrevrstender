# Production Environment Configuration for Reverse Tender Platform
# This file contains production-specific overrides for base.env

# Application Configuration
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=warning

# Database Configuration - Production Neon PostgreSQL
# Primary connection method (recommended)
DATABASE_URL=${NEON_DATABASE_URL}

# Individual parameters (fallback/legacy support)
DB_HOST=${NEON_DB_HOST}
DB_DATABASE=${NEON_DB_DATABASE}
DB_USERNAME=${NEON_DB_USERNAME}
DB_PASSWORD=${NEON_DB_PASSWORD}
DB_SSLMODE=require

# Upstash Redis Configuration - Production
REDIS_URL=${UPSTASH_REDIS_URL}
REDIS_TLS_URL=${UPSTASH_REDIS_TLS_URL}

# Cache Configuration
CACHE_PREFIX=rt_prod_

# Session Configuration
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_PREFIX=rt_prod_queue_

# Mail Configuration - Production SMTP
MAIL_HOST=${SMTP_HOST}
MAIL_USERNAME=${SMTP_USERNAME}
MAIL_PASSWORD=${SMTP_PASSWORD}

# Security Configuration - Production
BCRYPT_ROUNDS=15
HASH_VERIFY=true
APP_KEY=${APP_KEY}

# JWT Configuration - Production
JWT_SECRET=${JWT_SECRET}
JWT_PUBLIC_KEY=${JWT_PUBLIC_KEY}
JWT_PRIVATE_KEY=${JWT_PRIVATE_KEY}

# Laravel Octane Configuration - Production
OCTANE_WORKERS=8
OCTANE_TASK_WORKERS=12
OCTANE_MAX_REQUESTS=1000
OCTANE_MEMORY_LIMIT=1024M
OCTANE_WATCH=false
OCTANE_RELOAD_ON_CHANGE=false

# FrankenPHP Configuration - Production
FRANKENPHP_WORKER_MODE=true
FRANKENPHP_NUM_THREADS=8

# Performance Optimization - Production
PHP_OPCACHE_ENABLE=1
PHP_OPCACHE_MEMORY_CONSUMPTION=512
PHP_OPCACHE_MAX_ACCELERATED_FILES=50000
PHP_OPCACHE_VALIDATE_TIMESTAMPS=0
PHP_REALPATH_CACHE_SIZE=8192K
PHP_REALPATH_CACHE_TTL=3600

# Monitoring Configuration
MONITORING_ENABLED=true
PROMETHEUS_METRICS_ENABLED=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"

# SSL/TLS Configuration
FORCE_HTTPS=true
HSTS_ENABLED=true

# Rate Limiting - Production
API_RATE_LIMIT=120
API_RATE_LIMIT_WINDOW=1

# File Upload - Production
MAX_FILE_SIZE=20480
UPLOAD_DISK=s3

# Feature Flags - Production
RATE_LIMIT_ENABLED=true
TESSERACT_ENABLED=true
BACKUP_ENABLED=true
