# Payment Service Environment Configuration
# This file contains environment-specific settings for the payment service

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION
# =============================================================================

# Stripe Configuration
STRIPE_ENABLED=true
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_API_VERSION=2023-10-16

# PayPal Configuration
PAYPAL_ENABLED=true
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Mada Configuration (Saudi Arabia)
MADA_ENABLED=true
MADA_MERCHANT_ID=your_mada_merchant_id_here
MADA_TERMINAL_ID=your_mada_terminal_id_here
MADA_SECRET_KEY=your_mada_secret_key_here
MADA_API_URL=https://api.mada.sa/v1

# STC Pay Configuration (Saudi Arabia)
STC_PAY_ENABLED=true
STC_PAY_MERCHANT_ID=your_stc_pay_merchant_id_here
STC_PAY_SECRET_KEY=your_stc_pay_secret_key_here
STC_PAY_API_URL=https://api.stcpay.com.sa/v1

# Razorpay Configuration (Optional)
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Square Configuration (Optional)
SQUARE_ENABLED=false
SQUARE_APPLICATION_ID=your_square_application_id_here
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key_here
SQUARE_ENVIRONMENT=sandbox

# =============================================================================
# PAYMENT PROCESSING CONFIGURATION
# =============================================================================

# Currency and Amount Settings
PAYMENT_DEFAULT_CURRENCY=SAR
PAYMENT_SUPPORTED_CURRENCIES=SAR,USD,EUR,AED
PAYMENT_MAX_AMOUNT=1000000
PAYMENT_MIN_AMOUNT=1

# Processing Settings
PAYMENT_TIMEOUT=300
PAYMENT_RETRY_ATTEMPTS=3

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================

# Webhook Processing Settings
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_ATTEMPTS=5
WEBHOOK_RETRY_DELAY=60
WEBHOOK_SIGNATURE_VERIFICATION=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Encryption and Security
PAYMENT_ENCRYPTION_KEY=your_32_character_encryption_key_here
PAYMENT_HASH_ALGORITHM=sha256
PAYMENT_TOKEN_EXPIRY=3600
PAYMENT_RATE_LIMIT=100

# =============================================================================
# ANALYTICS AND MONITORING
# =============================================================================

# Analytics Settings
PAYMENT_ANALYTICS_ENABLED=true
PAYMENT_METRICS_ENABLED=true
PAYMENT_AUDIT_ENABLED=true
PAYMENT_LOGGING_LEVEL=info

# =============================================================================
# RPC CONFIGURATION
# =============================================================================

# RPC Settings
RPC_ENABLED=true
RPC_TIMEOUT=30
RPC_RETRY_ATTEMPTS=3

# =============================================================================
# LEGACY ZATCA CONFIGURATION (Backward Compatibility)
# =============================================================================

# ZATCA Settings (for existing integrations)
ZATCA_API_URL=https://api.zatca.gov.sa/v1
ZATCA_API_KEY=your_zatca_api_key_here
ZATCA_CERTIFICATE=your_zatca_certificate_here

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Laravel Octane Settings
OCTANE_WORKERS=6
OCTANE_TASK_WORKERS=8
OCTANE_MAX_REQUESTS=500
OCTANE_MEMORY_LIMIT=1G

# FrankenPHP Settings
FRANKENPHP_NUM_THREADS=6

# PHP OPCache Settings
PHP_OPCACHE_MEMORY_CONSUMPTION=512

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================

# Development-specific settings (override in development environments)
# APP_DEBUG=true
# LOG_LEVEL=debug
# WEBHOOK_SIGNATURE_VERIFICATION=false
# PAYMENT_ENCRYPTION_KEY=dev-encryption-key-change-in-production
