# =============================================================================
# ENVIRONMENT-SPECIFIC SECRETS
# =============================================================================

# Development environment secrets (use weak/test values)
# - Use local database instances where possible
# - Use mock/test API keys for external services
# - Enable verbose logging and debugging

# Staging environment secrets (use sandbox/test values)
# - Use staging/test database instances
# - Use sandbox API keys for external services
# - Mirror production configuration with reduced resources

# Production environment secrets (use strong/real values)
# - Use production database instances with high availability
# - Use production API keys for external services
# - Enable comprehensive monitoring and alerting
# - Implement proper secret rotation policies

# =============================================================================
# SECRET ROTATION CONFIGURATION
# =============================================================================

# Secret rotation schedule (for automated rotation)
DB_SECRET_ROTATION_ENABLED=true
DB_SECRET_ROTATION_SCHEDULE="0 3 1 * *"  # Monthly at 3 AM on 1st day
DB_SECRET_ROTATION_RETENTION_DAYS=30

# Rotation notification settings
DB_SECRET_ROTATION_WEBHOOK=CHANGE_ME_rotation_webhook
DB_SECRET_ROTATION_EMAIL=CHANGE_ME_rotation_email

# =============================================================================
# INSTRUCTIONS FOR USAGE
# =============================================================================

# 1. Copy this file to create environment-specific secret files:
#    cp database-failover-secrets.env.example database-failover-secrets.development.env
#    cp database-failover-secrets.env.example database-failover-secrets.staging.env
#    cp database-failover-secrets.env.example database-failover-secrets.production.env

# 2. Replace all "CHANGE_ME_" values with actual secrets for each environment

# 3. Ensure proper file permissions (readable only by application user):
#    chmod 600 database-failover-secrets.*.env

# 4. Add secret files to .gitignore to prevent accidental commits:
#    echo "database-failover-secrets.*.env" >> .gitignore

# 5. Use environment-specific secret files in your deployment scripts:
#    source deployment/config/database-failover-secrets.production.env

# 6. For Kubernetes deployments, create secrets from these files:
#    kubectl create secret generic database-failover-secrets \
#      --from-env-file=deployment/config/database-failover-secrets.production.env

# 7. Implement proper secret rotation and monitoring procedures
