# Example Optimized Dockerfile for Laravel Microservice
# Base: serversideup/php:8.3.27-frankenphp-alpine
# Features: Multi-stage build, Alpine Linux, FrankenPHP, optimized layers

###########################################
# Stage 1: Node.js Dependencies & Assets
###########################################
FROM node:18-alpine AS node-builder

WORKDIR /app

# Copy package files for better layer caching
COPY package*.json ./
COPY yarn.lock* ./

# Install Node.js dependencies with cache optimization
RUN if [ -f "yarn.lock" ]; then \
        yarn install --frozen-lockfile --production=false; \
    elif [ -f "package-lock.json" ]; then \
        npm ci --include=dev; \
    else \
        npm install; \
    fi

# Copy source files and build assets
COPY . .

# Build frontend assets (Vite/Laravel Mix)
RUN if [ -f "package.json" ]; then \
        if [ -f "vite.config.js" ] || [ -f "vite.config.ts" ]; then \
            npm run build; \
        elif [ -f "webpack.mix.js" ]; then \
            npm run production; \
        fi; \
    fi

###########################################
# Stage 2: PHP Dependencies & Optimization
###########################################
FROM serversideup/php:8.3.27-frankenphp-alpine AS php-builder

WORKDIR /var/www/html

# Install build dependencies (minimal set)
USER root
RUN apk add --no-cache \
        git \
        unzip \
        libzip-dev \
        libpng-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        oniguruma-dev \
        postgresql-dev \
        redis \
    && rm -rf /var/cache/apk/*

# Install PHP extensions (optimized for Laravel)
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_mysql \
        pdo_pgsql \
        zip \
        gd \
        mbstring \
        exif \
        pcntl \
        bcmath \
        opcache

# Install Redis extension
RUN pecl install redis && docker-php-ext-enable redis

# Copy composer files for layer caching
COPY composer.json composer.lock* ./

# Install Composer dependencies (production optimized)
USER www-data
RUN composer install \
        --no-dev \
        --no-scripts \
        --no-autoloader \
        --optimize-autoloader \
        --prefer-dist \
        --no-interaction

# Copy application source
COPY --chown=www-data:www-data . .

# Generate optimized autoloader
RUN composer dump-autoload --optimize --classmap-authoritative

# Laravel optimizations (cache config, routes, views)
RUN if [ -f "artisan" ]; then \
        php artisan config:cache && \
        php artisan route:cache && \
        php artisan view:cache; \
    fi

###########################################
# Stage 3: Production Runtime (Minimal)
###########################################
FROM serversideup/php:8.3.27-frankenphp-alpine AS production

# Production environment variables
ENV APP_ENV=production
ENV APP_DEBUG=false
ENV LOG_CHANNEL=stderr
ENV COMPOSER_ALLOW_SUPERUSER=1

WORKDIR /var/www/html

# Install only runtime dependencies
USER root
RUN apk add --no-cache \
        postgresql-client \
        redis \
        curl \
    && rm -rf /var/cache/apk/* \
    && rm -rf /tmp/*

# Install minimal PHP extensions for runtime
RUN docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_mysql \
        pdo_pgsql \
        zip \
        gd \
        mbstring \
        exif \
        pcntl \
        bcmath \
        opcache

# Install Redis extension
RUN pecl install redis && docker-php-ext-enable redis

# Configure PHP for production performance
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.interned_strings_buffer=16" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=10000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.save_comments=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.fast_shutdown=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "realpath_cache_size=4096K" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "realpath_cache_ttl=600" >> /usr/local/etc/php/conf.d/opcache.ini

# Copy optimized application from builder
COPY --from=php-builder --chown=www-data:www-data /var/www/html .

# Copy built assets from node builder (if they exist)
COPY --from=node-builder --chown=www-data:www-data /app/public/build* ./public/ 2>/dev/null || true
COPY --from=node-builder --chown=www-data:www-data /app/public/mix-manifest.json ./public/ 2>/dev/null || true

# Set proper permissions (security hardening)
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html/storage \
    && chmod -R 755 /var/www/html/bootstrap/cache \
    && find /var/www/html -type f -exec chmod 644 {} \; \
    && find /var/www/html -type d -exec chmod 755 {} \;

# Create FrankenPHP configuration
RUN echo '{\
    "apps": {\
        "http": {\
            "servers": {\
                "srv0": {\
                    "listen": [":8000"],\
                    "routes": [{\
                        "handle": [{\
                            "handler": "php_server",\
                            "root": "/var/www/html/public",\
                            "index": ["index.php"]\
                        }]\
                    }]\
                }\
            }\
        }\
    }\
}' > /etc/caddy/Caddyfile.json

# Switch to non-root user for security
USER www-data

# Health check for container monitoring
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Use FrankenPHP as the high-performance server
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile.json"]

# Metadata labels
LABEL maintainer="Laravel Microservices Team"
LABEL version="1.0"
LABEL description="Optimized Laravel microservice with FrankenPHP and Alpine Linux"
LABEL org.opencontainers.image.source="https://github.com/abdoElHodaky/larvrevrstender"

