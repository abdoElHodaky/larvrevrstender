APP_NAME=AuctionService
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (Neon) Database Configuration
DB_CONNECTION=pgsql
DB_URL=postgresql://username:password@host:5432/database_name
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_DATABASE=auction_service_db
DB_USERNAME=postgres_user
DB_PASSWORD=your_secure_password
DB_CHARSET=utf8

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=

# Queue Configuration
QUEUE_CONNECTION=redis

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Microservices URLs
BIDDING_SERVICE_URL=http://bidding-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
AUTH_SERVICE_URL=http://auth-service:8000
FILE_UPLOAD_SERVICE_URL=http://file-upload-service:8000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_TTL=60

# File Storage Configuration
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Broadcasting
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"

# RPC Configuration
RPC_CLIENT_TIMEOUT=30
RPC_CLIENT_RETRY_ATTEMPTS=3
RPC_CLIENT_RETRY_DELAY=1000

# RPC Service URLs
RPC_BIDDING_SERVICE_URL=http://bidding-service:8080/rpc
RPC_BIDDING_SERVICE_TOKEN=3db566ed|3db566ed7e34fbace497dc45a48e41c45e22f40c8de161db2e6df7771d9d6899

RPC_ORDER_SERVICE_URL=http://order-service:8080/rpc
RPC_ORDER_SERVICE_TOKEN=460452e3|460452e303fc2c155984b881188c035c8e1358807c98b1d23755e44bdfd75195

RPC_USER_SERVICE_URL=http://user-service:8080/rpc
RPC_USER_SERVICE_TOKEN=9a4347b9|9a4347b99ad2445fbb6aceedb2c8cec6c4edac6e3132551ef328d3126d55a15f

RPC_NOTIFICATION_SERVICE_URL=http://notification-service:8080/rpc
RPC_NOTIFICATION_SERVICE_TOKEN=7906330b|7906330b5e252c35a2c847797222b471010eb46de96eb410ff0db85fe1517fe7

# Varnish Cache Configuration
VARNISH_ENABLED=true
VARNISH_HOST=varnish
VARNISH_PORT=80
VARNISH_ADMIN_PORT=6081
VARNISH_TTL=300
VARNISH_GRACE=3600

# Cache Headers Configuration
CACHE_CONTROL_MAX_AGE=300
CACHE_CONTROL_PUBLIC=true
ETAG_ENABLED=true
LAST_MODIFIED_ENABLED=true

# Database Failover Configuration
DATABASE_FAILOVER_ENABLED=true
DB_PRIMARY_CONNECTION=pgsql
DB_SECONDARY_CONNECTION=pgsql_secondary
DB_FALLBACK_CONNECTION=mongodb
DB_HEALTH_CHECK_INTERVAL=30
DB_AUTOMATIC_FAILOVER=true
DB_ENABLE_GRACEFUL_DEGRADATION=true

# Primary Database (Neon PostgreSQL)
NEON_DB_HOST=127.0.0.1
NEON_DB_PORT=5432
NEON_DB_DATABASE=auction_service
NEON_DB_USERNAME=postgres
NEON_DB_PASSWORD=

# Secondary Database (Cloud PostgreSQL)
CLOUD_DB_HOST=127.0.0.1
CLOUD_DB_PORT=5433
CLOUD_DB_DATABASE=auction_service
CLOUD_DB_USERNAME=postgres
CLOUD_DB_PASSWORD=

# Fallback Database (MongoDB)
MONGO_DB_HOST=127.0.0.1
MONGO_DB_PORT=27017
MONGO_DB_DATABASE=auction_service
MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=

RPC_AUTH_SERVICE_TOKEN=be704735|be70473501d29854b8a7deafe75f4c8f07390bfc8d828db01f63ec18201fb8a5
RPC_PAYMENT_SERVICE_TOKEN=71b1880f|71b1880f548bf8e5cc027a4131cb14d24bf74b5d5207ec91b60fbc9fadbbba18
RPC_ANALYTICS_SERVICE_TOKEN=45cb91cf|45cb91cf7c3160e4cdef4da0af151cc11e4478f127d7be28cfecab7d8bc2f3ca
RPC_VIN_OCR_SERVICE_TOKEN=9495bc33|9495bc331596d441238c5ac47a1ca2bc8f1e6f0a49894b645b1f5788fd3e0cdc
RPC_GATEWAY_SERVICE_TOKEN=c6687229|c6687229ddf7b3d9154fbf6fa43427fbeeffd7df43a40d5eb10c532d44b45f75