APP_NAME=AuctionService
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (Neon) Database Configuration
DB_CONNECTION=pgsql
DB_URL=postgresql://username:password@host:5432/database_name
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_DATABASE=auction_service_db
DB_USERNAME=postgres_user
DB_PASSWORD=your_secure_password
DB_CHARSET=utf8

# Redis (Upstash) Configuration
REDIS_CLIENT=phpredis
REDIS_URL=redis://default:password@host:port
REDIS_HOST=your-upstash-host.upstash.io
REDIS_USERNAME=default
REDIS_PASSWORD=your_upstash_password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=

# Queue Configuration
QUEUE_CONNECTION=redis

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Microservices URLs
BIDDING_SERVICE_URL=http://bidding-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
AUTH_SERVICE_URL=http://auth-service:8000
FILE_UPLOAD_SERVICE_URL=http://file-upload-service:8000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_TTL=60

# File Storage Configuration
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Broadcasting
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"

# RPC Configuration
RPC_CLIENT_TIMEOUT=30
RPC_CLIENT_RETRY_ATTEMPTS=3
RPC_CLIENT_RETRY_DELAY=1000

# RPC Service URLs
RPC_BIDDING_SERVICE_URL=http://bidding-service:8080/rpc
RPC_BIDDING_SERVICE_TOKEN=

RPC_ORDER_SERVICE_URL=http://order-service:8080/rpc
RPC_ORDER_SERVICE_TOKEN=

RPC_USER_SERVICE_URL=http://user-service:8080/rpc
RPC_USER_SERVICE_TOKEN=

RPC_NOTIFICATION_SERVICE_URL=http://notification-service:8080/rpc
RPC_NOTIFICATION_SERVICE_TOKEN=

# Varnish Cache Configuration
VARNISH_ENABLED=true
VARNISH_HOST=varnish
VARNISH_PORT=80
VARNISH_ADMIN_PORT=6081
VARNISH_TTL=300
VARNISH_GRACE=3600

# Cache Headers Configuration
CACHE_CONTROL_MAX_AGE=300
CACHE_CONTROL_PUBLIC=true
ETAG_ENABLED=true
LAST_MODIFIED_ENABLED=true

# Database Failover Configuration
DATABASE_FAILOVER_ENABLED=true
DB_PRIMARY_CONNECTION=pgsql
DB_SECONDARY_CONNECTION=pgsql_secondary
DB_FALLBACK_CONNECTION=mongodb
DB_HEALTH_CHECK_INTERVAL=30
DB_AUTOMATIC_FAILOVER=true
DB_ENABLE_GRACEFUL_DEGRADATION=true

# Primary Database (Neon PostgreSQL)
NEON_DB_HOST=127.0.0.1
NEON_DB_PORT=5432
NEON_DB_DATABASE=auction_service
NEON_DB_USERNAME=postgres
NEON_DB_PASSWORD=

# Secondary Database (Cloud PostgreSQL)
CLOUD_DB_HOST=127.0.0.1
CLOUD_DB_PORT=5433
CLOUD_DB_DATABASE=auction_service
CLOUD_DB_USERNAME=postgres
CLOUD_DB_PASSWORD=

# Fallback Database (MongoDB)
MONGO_DB_HOST=127.0.0.1
MONGO_DB_PORT=27017
MONGO_DB_DATABASE=auction_service
MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=
