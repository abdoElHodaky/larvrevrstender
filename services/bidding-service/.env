RPC_PAYMENT_SERVICE_TOKEN=850dacd5|850dacd52d4191629146fc2ebd06dc66a60adfb899cffce28b8d200a75ab5f2d

RPC_AUCTION_SERVICE_URL=http://auction-service:8080/rpc
