RPC_NOTIFICATION_SERVICE_URL=http://notification-service:8080/rpc
RPC_NOTIFICATION_SERVICE_TOKEN=dd614741|dd61474160d5a02178defb85dcf008f1ff27d970153cf038a8a74c952564f135

RPC_ANALYTICS_SERVICE_URL=http://analytics-service:8080/rpc
RPC_ANALYTICS_SERVICE_TOKEN=86787f80|86787f803b679f2f201ead83d718405e38f6c79f2db07ea5c28491a9e44fd43d

RPC_VIN_OCR_SERVICE_URL=http://vin-ocr-service:8080/rpc
RPC_VIN_OCR_SERVICE_TOKEN=c7df43eb|c7df43eb4b6980bec9b0e0766698b993c215a7893288c51fc26c57a69c5c298b

RPC_GATEWAY_SERVICE_URL=http://gateway-service:8080/rpc
RPC_GATEWAY_SERVICE_TOKEN=26fc3aa2|26fc3aa25bd3c040cb755bda2cfeb5a79a7e186ae9cb6c7962adf0259d078d9f

# Varnish Cache Configuration
VARNISH_ENABLED=true
VARNISH_HOST=varnish
VARNISH_PORT=80
VARNISH_ADMIN_PORT=6081
VARNISH_TTL=300
VARNISH_GRACE=3600

# Cache Headers Configuration
CACHE_CONTROL_MAX_AGE=300
CACHE_CONTROL_PUBLIC=true
ETAG_ENABLED=true
LAST_MODIFIED_ENABLED=true

# Database Failover Configuration
DATABASE_FAILOVER_ENABLED=true
DB_PRIMARY_CONNECTION=pgsql
DB_SECONDARY_CONNECTION=pgsql_secondary
DB_FALLBACK_CONNECTION=mongodb
DB_HEALTH_CHECK_INTERVAL=30
DB_AUTOMATIC_FAILOVER=true
DB_ENABLE_GRACEFUL_DEGRADATION=true

# Primary Database (Neon PostgreSQL)
NEON_DB_HOST=127.0.0.1
NEON_DB_PORT=5432
NEON_DB_DATABASE=bidding_service
NEON_DB_USERNAME=postgres
NEON_DB_PASSWORD=

# Secondary Database (Cloud PostgreSQL)
CLOUD_DB_HOST=127.0.0.1
CLOUD_DB_PORT=5433
CLOUD_DB_DATABASE=bidding_service
CLOUD_DB_USERNAME=postgres
CLOUD_DB_PASSWORD=

# Fallback Database (MongoDB)
MONGO_DB_HOST=127.0.0.1
MONGO_DB_PORT=27017
MONGO_DB_DATABASE=bidding_service
MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=
