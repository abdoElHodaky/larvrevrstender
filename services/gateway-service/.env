RPC_PAYMENT_SERVICE_URL=http://payment-service:8080/rpc
RPC_PAYMENT_SERVICE_TOKEN=da1be08f|da1be08f8a31cab6dceaa9d106d4350f50e0d65f9135f660e15d0d945e63d076

