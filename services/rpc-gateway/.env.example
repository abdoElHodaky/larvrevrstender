APP_NAME="RPC Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rpc_gateway
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Octane Configuration
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000
OCTANE_WORKERS=4
OCTANE_TASK_WORKERS=6
OCTANE_MAX_REQUESTS=500
OCTANE_MEMORY_LIMIT=512M

# FrankenPHP Configuration
FRANKENPHP_WORKER_MODE=true
FRANKENPHP_NUM_THREADS=4

# RPC Gateway Configuration
GATEWAY_PORT=8000
GATEWAY_TIMEOUT=30
GATEWAY_MAX_RETRIES=3
GATEWAY_CIRCUIT_BREAKER_ENABLED=true
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_REQUESTS=1000
GATEWAY_RATE_LIMIT_WINDOW=60

# Service Discovery
SERVICE_DISCOVERY_TYPE=static
SERVICE_REGISTRY_HOST=127.0.0.1
SERVICE_REGISTRY_PORT=8500

# RPC Services Configuration
AUTH_SERVICE_URL=http://127.0.0.1:8001
USER_SERVICE_URL=http://127.0.0.1:8002
ANALYTICS_SERVICE_URL=http://127.0.0.1:8003
ORDER_SERVICE_URL=http://127.0.0.1:8004
PAYMENT_SERVICE_URL=http://127.0.0.1:8005
BIDDING_SERVICE_URL=http://127.0.0.1:8006
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8007
VIN_OCR_SERVICE_URL=http://127.0.0.1:8008
SHARED_SERVICE_URL=http://127.0.0.1:8009

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# Monitoring & Observability
TELESCOPE_ENABLED=true
HORIZON_ENABLED=true
PROMETHEUS_ENABLED=true
METRICS_EXPORT_INTERVAL=60

# Security
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:3000,::1

# Rate Limiting
RATE_LIMIT_GLOBAL_ENABLED=true
RATE_LIMIT_GLOBAL_REQUESTS=10000
RATE_LIMIT_GLOBAL_WINDOW=60

RATE_LIMIT_PER_USER_ENABLED=true
RATE_LIMIT_PER_USER_REQUESTS=1000
RATE_LIMIT_PER_USER_WINDOW=60

RATE_LIMIT_PER_SERVICE_ENABLED=true
RATE_LIMIT_PER_SERVICE_REQUESTS=5000
RATE_LIMIT_PER_SERVICE_WINDOW=60

# Load Balancing
LOAD_BALANCER_ALGORITHM=round_robin
LOAD_BALANCER_HEALTH_CHECK=true
LOAD_BALANCER_STICKY_SESSIONS=false

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_EXPECTED_EXCEPTION_THRESHOLD=10

# Caching
GATEWAY_CACHE_ENABLED=true
GATEWAY_CACHE_TTL=300
GATEWAY_CACHE_TAGS_ENABLED=true

# WebSocket Support
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=6001
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
