APP_NAME="RPC Gateway Testing"
APP_ENV=testing
APP_KEY=base64:YourBase64EncodedKeyHereForTestingEnvironment123456789=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# RPC Gateway Testing Configuration
GATEWAY_PORT=8000
GATEWAY_TIMEOUT=10
GATEWAY_MAX_RETRIES=1
GATEWAY_CIRCUIT_BREAKER_ENABLED=false
GATEWAY_RATE_LIMIT_ENABLED=false

# Test Service URLs (using mock services)
AUTH_SERVICE_URL=http://127.0.0.1:8001
USER_SERVICE_URL=http://127.0.0.1:8002
ANALYTICS_SERVICE_URL=http://127.0.0.1:8003
ORDER_SERVICE_URL=http://127.0.0.1:8004
PAYMENT_SERVICE_URL=http://127.0.0.1:8005
BIDDING_SERVICE_URL=http://127.0.0.1:8006
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8007
VIN_OCR_SERVICE_URL=http://127.0.0.1:8008
SHARED_SERVICE_URL=http://127.0.0.1:8009

# Disable external services for testing
HEALTH_CHECK_ENABLED=false
TELESCOPE_ENABLED=false
HORIZON_ENABLED=false
PROMETHEUS_ENABLED=false

# Testing Security
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_TTL=60

# Disable rate limiting for tests
RATE_LIMIT_GLOBAL_ENABLED=false
RATE_LIMIT_PER_USER_ENABLED=false
RATE_LIMIT_PER_SERVICE_ENABLED=false

# Testing Load Balancing
LOAD_BALANCER_ALGORITHM=round_robin
LOAD_BALANCER_HEALTH_CHECK=false

# Disable caching for tests
GATEWAY_CACHE_ENABLED=false

# Disable WebSocket for tests
WEBSOCKET_ENABLED=false
