# Shared Service Environment Configuration
# This is a library package - minimal configuration needed

APP_NAME="Shared Service Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Database Configuration (for testing)
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Cache Configuration
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Redis Configuration (for testing)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# RPC Configuration (for client connections)
# Note: This is a shared library - these are default values for RPC clients
RPC_TIMEOUT=30
RPC_RETRY_ATTEMPTS=3
RPC_RETRY_DELAY=1000

# Service URLs (used by RPC clients)
AUTH_URL=http://auth-service:8001
USERS_URL=http://user-service:8002
AUCTIONS_URL=http://auction-service:8003
BIDDING_URL=http://bidding-service:8004
ORDERS_URL=http://order-service:8005
PAYMENTS_URL=http://payment-service:8006
GATEWAY_URL=http://gateway-service:8007
NOTIFICATIONS_URL=http://notification-service:8008
ANALYTICS_URL=http://analytics-service:8009
VIN_OCR_URL=http://vin-ocr-service:8010

# RPC Authentication Tokens (for client authentication)
AUTH_TOKEN=auth_service_token_placeholder
USERS_TOKEN=user_service_token_placeholder
AUCTIONS_TOKEN=auction_service_token_placeholder
BIDDING_TOKEN=bidding_service_token_placeholder
ORDERS_TOKEN=order_service_token_placeholder
PAYMENTS_TOKEN=payment_service_token_placeholder
GATEWAY_TOKEN=gateway_service_token_placeholder
NOTIFICATIONS_TOKEN=notification_service_token_placeholder
ANALYTICS_TOKEN=analytics_service_token_placeholder
VIN_OCR_TOKEN=vin_ocr_service_token_placeholder
