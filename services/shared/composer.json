{
    "name": "larvrevrstender/shared",
    "description": "Shared procedures and utilities for Laravel Reverse Tender microservices",
    "type": "library",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Shared\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shared\\Providers\\SharedServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
