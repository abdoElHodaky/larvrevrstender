{
    "name": "reversetender/shared-service",
    "description": "Cross-service infrastructure for Laravel microservices with REST and RPC communication patterns",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Reverse Tender Team",
            "email": "dev@reversetender.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "laravel/framework": "^12.0",
        "nesbot/carbon": "^3.0",
        "predis/predis": "^2.0",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/http-foundation": "^7.0",
        "psr/log": "^3.0",
        "psr/cache": "^3.0",
        "psr/http-message": "^2.0",
        "monolog/monolog": "^3.0",
        "ramsey/uuid": "^4.0",
        "league/fractal": "^0.20",
        "vlucas/phpdotenv": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23",
        "phpstan/phpstan": "^1.10",
        "rector/rector": "^1.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Shared\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shared\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "analyse": "phpstan analyse",
        "format": "pint",
        "refactor": "rector process"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Shared\\Providers\\SharedServiceProvider"
            ]
        }
    }
}
