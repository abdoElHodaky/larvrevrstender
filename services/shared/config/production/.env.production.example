# Database Failover System - Production Environment Configuration
# Copy this file to .env.production and update the values for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0

# =============================================================================
# DATABASE FAILOVER CONFIGURATION
# =============================================================================
DATABASE_FAILOVER_ENABLED=true

# Health Check Settings
DB_HEALTH_CHECK_INTERVAL=30
DB_HEALTH_CHECK_TIMEOUT=5
DB_HEALTH_CHECK_RETRY_COUNT=3
DB_HEALTH_FAILURE_THRESHOLD=3

# Failover Timing
DB_FAILOVER_TIMEOUT=10
DB_FAILOVER_RETRY_ATTEMPTS=2
DB_FAILOVER_BACKOFF_MULTIPLIER=2
DB_FAILOVER_MAX_BACKOFF=30

# Connection Limits
DB_PRIMARY_MAX_CONNECTIONS=100
DB_SECONDARY_MAX_CONNECTIONS=80
DB_FALLBACK_MAX_CONNECTIONS=50

# =============================================================================
# CIRCUIT BREAKER CONFIGURATION
# =============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=10
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=5

# =============================================================================
# EMAIL NOTIFICATION CONFIGURATION (SMTP2Go)
# =============================================================================
MAIL_MAILER=smtp2go
MAIL_HOST=mail.smtp2go.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp2go_username
MAIL_PASSWORD=your_smtp2go_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=database-alerts@yourcompany.com
MAIL_FROM_NAME="Database Failover System"

# Failover SMTP (Backup)
MAIL_FAILOVER_HOST=smtp.mailgun.org
MAIL_FAILOVER_PORT=587
MAIL_FAILOVER_USERNAME=your_mailgun_username
MAIL_FAILOVER_PASSWORD=your_mailgun_password
MAIL_FAILOVER_ENCRYPTION=tls

# Email Recipients (comma-separated)
DB_FAILOVER_OPS_TEAM_EMAILS=ops@yourcompany.com,devops@yourcompany.com
DB_FAILOVER_ENG_LEADS_EMAILS=engineering-leads@yourcompany.com,cto@yourcompany.com
DB_FAILOVER_ON_CALL_EMAILS=oncall@yourcompany.com,emergency@yourcompany.com

# Email Rate Limiting
DB_FAILOVER_MAX_EMAILS_PER_HOUR=10
DB_FAILOVER_EMAIL_COOLDOWN=300
MAIL_MAX_PER_MINUTE=10
MAIL_MAX_PER_HOUR=100

# =============================================================================
# SLACK NOTIFICATIONS (Optional)
# =============================================================================
DB_FAILOVER_SLACK_NOTIFICATIONS=false
DB_FAILOVER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
DB_FAILOVER_SLACK_CRITICAL_CHANNEL=#alerts-critical
DB_FAILOVER_SLACK_HIGH_CHANNEL=#alerts-high
DB_FAILOVER_SLACK_MEDIUM_CHANNEL=#alerts-medium

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
DB_FAILOVER_LOGGING_ENABLED=true
DB_FAILOVER_LOG_LEVEL=info
DB_FAILOVER_LOG_CHANNEL=stack
DB_FAILOVER_EVENTS_CHANNEL=database_failover
DB_FAILOVER_METRICS_CHANNEL=database_metrics
DB_FAILOVER_LOG_RETENTION_DAYS=30

# =============================================================================
# MONITORING AND METRICS
# =============================================================================
DB_FAILOVER_MONITORING_ENABLED=true
DB_FAILOVER_METRICS_INTERVAL=60
DB_QUERY_RESPONSE_TIME_THRESHOLD=1000
DB_CONNECTION_POOL_THRESHOLD=80
DB_CONSECUTIVE_FAILURES_ALERT=5
DB_RESPONSE_TIME_ALERT=2000

# =============================================================================
# RECOVERY AND FAILBACK SETTINGS
# =============================================================================
DB_AUTO_FAILBACK_ENABLED=true
DB_FAILBACK_HEALTH_CHECK_DURATION=300
DB_FAILBACK_SUCCESS_THRESHOLD=10

# =============================================================================
# ENVIRONMENT-SPECIFIC SETTINGS
# =============================================================================
AWS_DEFAULT_REGION=us-east-1
DB_CLUSTER_ID=prod-cluster-01

# =============================================================================
# SECURITY AND COMPLIANCE
# =============================================================================
DB_FAILOVER_ENCRYPT_LOGS=true
DB_FAILOVER_AUDIT_TRAIL=true

# =============================================================================
# PERFORMANCE OPTIMIZATION
# =============================================================================
DB_CONNECTION_POOLING_ENABLED=true
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=100
DB_IDLE_TIMEOUT=300
DB_SLOW_QUERY_THRESHOLD=1000
DB_QUERY_CACHE_ENABLED=true
DB_PREPARED_STATEMENTS=true

# =============================================================================
# QUEUE CONFIGURATION
# =============================================================================
QUEUE_CONNECTION=redis
DB_FAILOVER_MAIL_QUEUE=emails
CIRCUIT_BREAKER_MAIL_QUEUE=emails
TOPOLOGY_REPORT_MAIL_QUEUE=reports
DB_FAILOVER_QUEUE_CONNECTION=redis
CIRCUIT_BREAKER_QUEUE_CONNECTION=redis
TOPOLOGY_REPORT_QUEUE_CONNECTION=redis

# =============================================================================
# REDIS CONFIGURATION (for queues and caching)
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# DATABASE CONNECTIONS
# =============================================================================
# Primary Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=your-primary-db-host.amazonaws.com
DB_PORT=5432
DB_DATABASE=your_production_database
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Secondary Database (PostgreSQL Read Replica)
DB_SECONDARY_HOST=your-secondary-db-host.amazonaws.com
DB_SECONDARY_PORT=5432
DB_SECONDARY_DATABASE=your_production_database
DB_SECONDARY_USERNAME=your_db_username
DB_SECONDARY_PASSWORD=your_db_password

# Fallback Database (MongoDB)
MONGODB_HOST=your-mongodb-host.amazonaws.com
MONGODB_PORT=27017
MONGODB_DATABASE=your_fallback_database
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password

# =============================================================================
# TOPOLOGY REPORT SCHEDULING
# =============================================================================
TOPOLOGY_DAILY_SUMMARY_TIME=08:00
TOPOLOGY_WEEKLY_REPORT_DAY=monday

# =============================================================================
# MAIL SECURITY AND MONITORING
# =============================================================================
MAIL_RATE_LIMITING_ENABLED=true
MAIL_ENCRYPT_QUEUE_PAYLOADS=true
MAIL_VERIFY_SSL=true
MAIL_DELIVERY_NOTIFICATIONS=true
MAIL_BOUNCE_HANDLING=true
MAIL_FAILOVER_ENABLED=true
MAIL_PRIMARY_FAILURE_THRESHOLD=3
MAIL_FAILOVER_TIMEOUT=30
MAIL_HEALTH_CHECK_INTERVAL=300

# =============================================================================
# TESTING AND DEVELOPMENT (Set to false in production)
# =============================================================================
MAIL_LOG_ALL_EMAILS=false
MAIL_TEST_MODE=false
MAIL_SUPPRESS_DELIVERY=false
