# Shared Service Environment Configuration
# This is a library package - minimal configuration needed

APP_NAME="Shared Service Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Database Configuration (for testing)
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Cache Configuration
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Redis Configuration (for testing)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Varnish Cache Configuration
VARNISH_ENABLED=true
VARNISH_HOST=varnish
VARNISH_PORT=80
VARNISH_ADMIN_PORT=6081
VARNISH_TTL=300
VARNISH_GRACE=3600

# Cache Headers Configuration
CACHE_CONTROL_MAX_AGE=300
CACHE_CONTROL_PUBLIC=true
ETAG_ENABLED=true
LAST_MODIFIED_ENABLED=true
