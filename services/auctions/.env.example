APP_NAME=AuctionService
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (Neon) Database Configuration
DB_CONNECTION=pgsql
DB_URL=postgresql://username:password@host:5432/database_name
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_DATABASE=auction_service_db
DB_USERNAME=postgres_user
DB_PASSWORD=your_secure_password
DB_CHARSET=utf8

# Redis (Upstash) Configuration
REDIS_CLIENT=phpredis
REDIS_URL=redis://default:password@host:port
REDIS_HOST=your-upstash-host.upstash.io
REDIS_USERNAME=default
REDIS_PASSWORD=your_upstash_password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=

# Queue Configuration
QUEUE_CONNECTION=redis

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Microservices URLs
BIDDING_URL=http://bidding-service:8000
NOTIFICATIONS_URL=http://notification-service:8000
AUTH_URL=http://auth-service:8000
FILE_UPLOAD_SERVICE_URL=http://file-upload-service:8000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_TTL=60

# File Storage Configuration
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Broadcasting
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

# Vite Configuration
VITE_APP_NAME="Auctions"

# Inter-Service Communication Configuration
# Service Authentication Tokens
AUTH_TOKEN=your_auth_service_rpc_token_here
USERS_TOKEN=your_user_service_rpc_token_here
AUCTIONS_TOKEN=your_auction_service_rpc_token_here
BIDDING_TOKEN=your_bidding_service_rpc_token_here
ORDERS_TOKEN=your_order_service_rpc_token_here
PAYMENTS_TOKEN=your_payment_service_rpc_token_here
GATEWAY_TOKEN=your_gateway_service_rpc_token_here
NOTIFICATIONS_TOKEN=your_notification_service_rpc_token_here
ANALYTICS_TOKEN=your_analytics_service_rpc_token_here
VIN_OCR_TOKEN=your_vin_ocr_service_rpc_token_here

# Service URLs
AUTH_URL=http://localhost:8001
USERS_URL=http://localhost:8002
AUCTIONS_URL=http://localhost:8003
BIDDING_URL=http://localhost:8004
ORDERS_URL=http://localhost:8005
PAYMENTS_URL=http://localhost:8006
GATEWAY_URL=http://localhost:8000
NOTIFICATIONS_URL=http://localhost:8007
ANALYTICS_URL=http://localhost:8008
VIN_OCR_URL=http://localhost:8009

# RPC Configuration
RPC_TIMEOUT=30
RPC_RETRY_ATTEMPTS=3
RPC_RETRY_DELAY=1000
